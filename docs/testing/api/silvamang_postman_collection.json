{
  "info": {
    "name": "SILVAMANG AI API Testing",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api"
    },
    {
      "key": "token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@silvamang.test\",\n  \"password\": \"password\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/login"
          }
        }
      ]
    },
    {
      "name": "Species",
      "item": [
        {
          "name": "List Species",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/species"
          }
        }
      ]
    },
    {
      "name": "Scan Records",
      "item": [
        {
          "name": "List Scan Records",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/scan-records"
          }
        }
      ]
    },
    {
      "name": "AI",
      "item": [
        {
          "name": "AI Service Health",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{base_url}}/ai/service-health"
          }
        }
      ]
    },
    {
      "name": "Assistant",
      "item": [
        {
          "name": "Assistant Chat",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"What is the ecological role of Rhizophora apiculata?\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/ai/assistant/chat"
          }
        }
      ]
    }
  ]
}
