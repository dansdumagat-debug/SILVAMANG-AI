APP_NAME="SILVAMANG AI Service"
APP_ENV=local
APP_DEBUG=true
SERVICE_HOST=127.0.0.1
SERVICE_PORT=9000
MODEL_MODE=real
MOCK_MODEL_VERSION=0.1.0

# Existing trained CNN classifier.
CNN_MODEL_PATH=models/cnn_classifier/efficientnet_b0_best.pth
CNN_CLASS_ORDER_PATH=models/cnn_classifier/class_order.json

# Add your trained mangrove plant-part detector here.
YOLO_DETECTOR_MODEL_PATH=models/yolo_detector/best.pt

# Add your trained mangrove segmentation model here.
YOLO_SEGMENTATION_MODEL_PATH=models/yolo_segmenter/best.pt

# Use a TorchScript MiDaS/depth model for loading in this service.
MIDAS_MODEL_PATH=models/midas/midas_torchscript.pt
