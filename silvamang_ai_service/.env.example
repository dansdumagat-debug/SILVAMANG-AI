APP_NAME="SILVAMANG AI Service"
APP_ENV=local
APP_DEBUG=true
SERVICE_HOST=127.0.0.1
SERVICE_PORT=9000
MODEL_MODE=real
MOCK_MODEL_VERSION=0.1.0

# Existing trained CNN classifier.
CNN_MODEL_PATH=models/EfficientNet-B0/efficientnet_b0_runtime.pth
CNN_CLASS_ORDER_PATH=models/EfficientNet-B0/class_order.json

# Add your trained mangrove plant-part detector here.
YOLO_DETECTOR_MODEL_PATH="models/YOLOv8-Detector/yolo8 detection.pt"

# Add your trained mangrove segmentation model here.
YOLO_SEGMENTATION_MODEL_PATH="models/YOLOv8-Seg/yolo8 seg.pt"


# Compose sets APP_ENV=production, APP_DEBUG=false and serves on 0.0.0.0:9000.
# In Docker the paths above resolve inside the read-only /app/models mount.
